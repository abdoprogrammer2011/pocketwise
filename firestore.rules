rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isLinkedParent(childUid) {
      return isSignedIn()
        && userDoc(request.auth.uid).role == 'parent'
        && childUid in userDoc(request.auth.uid).linkedChildren;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isLinkedParent(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);

      match /{collection}/{docId} {
        allow read: if isOwner(userId) || isLinkedParent(userId);
        allow write: if isOwner(userId) || (isLinkedParent(userId) && collection == 'allowances');
      }
    }
  }
}
